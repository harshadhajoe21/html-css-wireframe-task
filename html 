<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Creative Web Page</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Header -->
    <header class="header">

        <div class="container header-content">

            <div class="logo">
                WebDesign
            </div>

            <!-- Navigation -->
            <nav class="navbar">
                <a href="#home">Home</a>
                <a href="#about">About</a>
                <a href="#services">Services</a>
                <a href="#contact">Contact</a>
            </nav>

        </div>

    </header>


    <!-- Main Content -->
    <main>

        <!-- Hero Section -->
        <section id="home" class="hero">

            <div class="container hero-content">

                <div class="hero-text">

                    <p class="small-title">
                        WELCOME TO OUR WEBSITE
                    </p>

                    <h1>
                        Simple & Modern
                        <span>Web Design</span>
                    </h1>

                    <p>
                        A clean and responsive webpage created using
                        HTML and CSS based on a wireframe concept.
                    </p>

                    <a href="#about" class="button">
                        Explore More
                    </a>

                </div>

                <div class="hero-box">
                    <div class="box-content">
                        <h2>HTML</h2>
                        <p>Structure</p>
                    </div>

                    <div class="box-content">
                        <h2>CSS</h2>
                        <p>Design</p>
                    </div>
                </div>

            </div>

        </section>


        <!-- About Section -->
        <section id="about" class="about section">

            <div class="container">

                <div class="section-heading">

                    <p>ABOUT THE PROJECT</p>

                    <h2>
                        Turning Ideas Into Web Pages
                    </h2>

                </div>

                <div class="about-content">

                    <div class="about-text">

                        <p>
                            This project demonstrates how a visual wireframe
                            can be converted into a functional static webpage
                            using HTML5 and CSS3.
                        </p>

                        <p>
                            The webpage follows a semantic structure and
                            uses responsive design techniques to provide
                            a better experience on different screen sizes.
                        </p>

                    </div>

                    <div class="about-card">

                        <h3>Project Goal</h3>

                        <p>
                            Create a clean, responsive and user-friendly
                            static webpage from a given design concept.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- Services Section -->
        <section id="services" class="services section">

            <div class="container">

                <div class="section-heading">

                    <p>WHAT WE USE</p>

                    <h2>
                        Development Features
                    </h2>

                </div>


                <div class="service-grid">

                    <!-- Card 1 -->
                    <article class="service-card">

                        <div class="icon">
                            01
                        </div>

                        <h3>Semantic HTML</h3>

                        <p>
                            HTML5 semantic elements are used to create
                            a clear and meaningful webpage structure.
                        </p>

                    </article>


                    <!-- Card 2 -->
                    <article class="service-card">

                        <div class="icon">
                            02
                        </div>

                        <h3>CSS Styling</h3>

                        <p>
                            CSS is used for colors, fonts, spacing,
                            alignment and overall visual appearance.
                        </p>

                    </article>


                    <!-- Card 3 -->
                    <article class="service-card">

                        <div class="icon">
                            03
                        </div>

                        <h3>Responsive Design</h3>

                        <p>
                            Media queries are used to make the webpage
                            suitable for mobile, tablet and desktop screens.
                        </p>

                    </article>

                </div>

            </div>

        </section>


        <!-- Process Section -->
        <section class="process section">

            <div class="container">

                <div class="section-heading">

                    <p>OUR APPROACH</p>

                    <h2>
                        Development Process
                    </h2>

                </div>


                <div class="process-grid">

                    <div class="process-item">

                        <span>01</span>

                        <h3>Analyze</h3>

                        <p>
                            Study the wireframe and identify the main
                            layout components.
                        </p>

                    </div>


                    <div class="process-item">

                        <span>02</span>

                        <h3>Develop</h3>

                        <p>
                            Create the HTML structure and apply CSS
                            styling based on the design.
                        </p>

                    </div>


                    <div class="process-item">

                        <span>03</span>

                        <h3>Test</h3>

                        <p>
                            Test the webpage on different screen sizes
                            and fix layout issues.
                        </p>

                    </div>


                    <div class="process-item">

                        <span>04</span>

                        <h3>Improve</h3>

                        <p>
                            Make final adjustments to improve
                            responsiveness and usability.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- Contact Section -->
        <section id="contact" class="contact section">

            <div class="container contact-box">

                <div>

                    <p class="small-title">
                        HAVE A PROJECT?
                    </p>

                    <h2>
                        Let's Create Something Great
                    </h2>

                    <p>
                        This section represents the contact area
                        of the webpage.
                    </p>

                </div>

                <a href="mailto:example@email.com" class="button">
                    Contact Us
                </a>

            </div>

        </section>

    </main>


    <!-- Footer -->
    <footer class="footer">

        <div class="container footer-content">

            <p>
                © 2026 WebDesign. All Rights Reserved.
            </p>

            <p>
                Designed using HTML & CSS
            </p>

        </div>

    </footer>


</body>
</html>